{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vgtree.dev/schemas/capability-map.schema.json",
  "title": "VGTREE Capability Map 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "map_version",
    "task_id",
    "title",
    "goal",
    "signals",
    "wide_pass_policy",
    "modules",
    "cross_cutting_constraints",
    "final_acceptance_matrix"
  ],
  "properties": {
    "map_version": { "const": "1.0" },
    "task_id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 500 },
    "goal": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "description": { "type": "string", "maxLength": 10000 },
    "explicit_class": { "enum": ["T0", "T1", "T2", "T3", "T4"] },
    "signals": { "$ref": "#/$defs/signals" },
    "specialized_match": { "$ref": "#/$defs/specialized_match" },
    "wide_pass_policy": { "enum": ["OFF", "ADVISORY", "REQUIRED"] },
    "modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/module" }
    },
    "cross_cutting_constraints": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/constraint" }
    },
    "final_acceptance_matrix": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/acceptance_row" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "wide_pass_policy": { "enum": ["ADVISORY", "REQUIRED"] }
        },
        "required": ["wide_pass_policy"]
      },
      "then": {
        "properties": {
          "final_acceptance_matrix": { "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "text_list": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      }
    },
    "id_list": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimated_files",
        "migration",
        "project_scale",
        "external_effect",
        "destructive",
        "cross_system",
        "irreversible"
      ],
      "properties": {
        "estimated_files": { "type": "integer", "minimum": 0 },
        "migration": { "type": "boolean" },
        "project_scale": { "type": "boolean" },
        "external_effect": { "type": "boolean" },
        "destructive": { "type": "boolean" },
        "cross_system": { "type": "boolean" },
        "irreversible": { "type": "boolean" }
      }
    },
    "specialized_match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_ref",
        "registered",
        "trigger_match",
        "context_match",
        "capability_match",
        "outcome_match",
        "safety_match"
      ],
      "properties": {
        "workflow_ref": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "registered": { "type": "boolean" },
        "trigger_match": { "type": "boolean" },
        "context_match": { "type": "boolean" },
        "capability_match": { "type": "boolean" },
        "outcome_match": { "type": "boolean" },
        "safety_match": { "type": "boolean" }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "purpose",
        "kind",
        "priority",
        "coverage_required",
        "depends_on",
        "minimum_viable_state",
        "baseline_evidence_requirements",
        "definition_of_done",
        "acceptance_evidence",
        "shared_interfaces",
        "deferred_details",
        "stop_condition"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "kind": { "enum": ["primary", "secondary"] },
        "priority": { "enum": ["P0", "P1", "P2", "DEFERRED"] },
        "coverage_required": { "type": "boolean" },
        "depends_on": { "$ref": "#/$defs/id_list" },
        "minimum_viable_state": { "$ref": "#/$defs/text_list" },
        "baseline_evidence_requirements": { "$ref": "#/$defs/text_list" },
        "definition_of_done": { "$ref": "#/$defs/text_list" },
        "acceptance_evidence": { "$ref": "#/$defs/text_list" },
        "shared_interfaces": { "$ref": "#/$defs/text_list" },
        "deferred_details": { "$ref": "#/$defs/text_list" },
        "stop_condition": { "type": "string", "maxLength": 2000 }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "owner_branch_id", "module_ids", "gate"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "owner_branch_id": { "$ref": "#/$defs/id" },
        "module_ids": {
          "allOf": [
            { "$ref": "#/$defs/id_list" },
            { "minItems": 1 }
          ]
        },
        "gate": { "enum": ["PRE_EXECUTION", "COVERAGE", "COMPLETION"] }
      }
    },
    "acceptance_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "criterion", "module_ids", "evidence_requirements", "gate"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "criterion": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "module_ids": {
          "allOf": [
            { "$ref": "#/$defs/id_list" },
            { "minItems": 1 }
          ]
        },
        "evidence_requirements": {
          "allOf": [
            { "$ref": "#/$defs/text_list" },
            { "minItems": 1 }
          ]
        },
        "gate": { "enum": ["integration", "final-verification"] }
      }
    }
  }
}

